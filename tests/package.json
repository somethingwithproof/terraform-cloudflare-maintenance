{
  "name": "terraform-cloudflare-maintenance-tests",
  "version": "1.0.0",
  "description": "Test suite for Terraform Cloudflare Maintenance Module",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir unit",
    "test:integration": "vitest run --dir integration",
    "lint": "cd .. && eslint --config tests/eslint.config.js worker.js tests",
    "lint:fix": "cd .. && eslint --config tests/eslint.config.js worker.js tests --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "miniflare": "^4.20260730.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
