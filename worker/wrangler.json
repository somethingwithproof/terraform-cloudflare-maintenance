{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maintenance-page-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "MAINTENANCE_ENABLED": "true",
    "MAINTENANCE_TITLE": "Maintenance Mode",
    "MAINTENANCE_MESSAGE": "We are currently performing scheduled maintenance. We will be back shortly.",
    "CONTACT_EMAIL": "support@example.com",
    "CUSTOM_CSS": "",
    "LOGO_URL": "",
    "MAINTENANCE_WINDOW_START": "",
    "MAINTENANCE_WINDOW_END": "",
    "RETRY_AFTER": "3600",
    "ALLOWED_IPS": "[]",
    "ALLOWED_REGIONS": "[]",
    "STATUS_PATH": "/__maintenance/status",
    "PAGES": "[]",
    "KV_FAILURE_MODE": "open",
    "KV_CACHE_TTL": "60"
  },
  "kv_namespaces": [
    {
      "binding": "MAINTENANCE_KV",
      "id": "local-maintenance-toggle"
    }
  ]
}
